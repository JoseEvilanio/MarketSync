generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────── USUÁRIOS & PERMISSÕES ───────────────

enum PerfilUsuario {
  ADMINISTRADOR
  GERENTE
  CAIXA
}

model Usuario {
  id         String         @id @default(uuid())
  nome       String
  email      String         @unique
  senha      String
  perfil     PerfilUsuario  @default(CAIXA)
  ativo      Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  vendas     Venda[]
  caixas     Caixa[]
  movimentosCaixa MovimentoCaixa[]
  auditorias Auditoria[]
  pedidosCompra          PedidoCompra[]
  recebimentos           Recebimento[]
  divergenciasResolvidas Divergencia[]  @relation("DivergenciaResolvidaPor")
  nfePedidos             NfePedido[]    @relation("NfePedidoVinculadoPor")
  eventosNfe             EventoNfe[]

  @@map("usuarios")
}

// ─────────────── CATEGORIAS ───────────────

model Categoria {
  id        String    @id @default(uuid())
  nome      String    @unique
  descricao String?
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  produtos  Produto[]

  @@map("categorias")
}

// ─────────────── FORNECEDORES ───────────────

model Fornecedor {
  id          String    @id @default(uuid())
  nome        String
  razaoSocial String?
  cnpj        String?   @unique
  telefone    String?
  whatsapp    String?
  email       String?
  endereco    String?
  cidade      String?
  bairro      String?
  contato     String?
  ativo       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  produtos    Produto[]
  compras     Compra[]
  pedidosCompra    PedidoCompra[]
  notasFiscais     NotaFiscalEntrada[]
  produtoFornecedor ProdutoFornecedor[]

  @@map("fornecedores")
}

enum TipoVenda {
  UNIDADE
  PESO
}

enum ModoPesagem {
  MANUAL
  CODIGO_BARRAS_BALANCA
}

// ─────────────── PRODUTOS ───────────────

model Produto {
  id              String      @id @default(uuid())
  codigoInterno   String?     @unique
  codigoBarras    String?     @unique
  nome            String
  descricao       String?
  categoriaId     String?
  marcaId         String?
  fornecedorId    String?
  unidade         String      @default("UN")
  tipoVenda       TipoVenda   @default(UNIDADE)
  modoPesagem     ModoPesagem @default(MANUAL)
  peso            Float?
  precoCompra     Decimal     @db.Decimal(10, 2) @default(0)
  custoMedio      Decimal?    @db.Decimal(10, 2)
  precoVenda      Decimal     @db.Decimal(10, 2)
  margemLucro     Float?
  estoqueAtual    Float       @default(0)
  estoqueMinimo   Float       @default(0)
  localizacao     String?
  imagem          String?
  ativo           Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  categoria       Categoria?  @relation(fields: [categoriaId], references: [id])
  marca           Marca?      @relation(fields: [marcaId], references: [id])
  fornecedor      Fornecedor? @relation(fields: [fornecedorId], references: [id])
  itensVenda      ItemVenda[]
  itensCompra     ItemCompra[]
  movimentosEstoque MovimentoEstoque[]
  etiquetas       Etiqueta[]
  pedidosCompraItens  PedidoCompraItem[]
  notaFiscalItens     NotaFiscalItem[]
  produtoFornecedor   ProdutoFornecedor[]
  recebimentosItens   RecebimentoItem[]
  divergencias        Divergencia[]

  @@map("produtos")
}

// ─────────────── MARCAS ───────────────

model Marca {
  id        String    @id @default(uuid())
  nome      String    @unique
  ativo     Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  produtos  Produto[]

  @@map("marcas")
}

// ─────────────── CLIENTES ───────────────

model Cliente {
  id            String    @id @default(uuid())
  nome          String
  cpf           String?   @unique
  telefone      String?
  whatsapp      String?
  endereco      String?
  cidade        String?
  bairro        String?
  limiteCredito Decimal   @db.Decimal(10, 2) @default(0)
  observacoes   String?
  ativo         Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  vendas        Venda[]

  @@map("clientes")
}

// ─────────────── CAIXA ───────────────

enum StatusCaixa {
  ABERTO
  FECHADO
}

model Caixa {
  id             String      @id @default(uuid())
  usuarioId      String
  status         StatusCaixa @default(ABERTO)
  valorAbertura  Decimal     @db.Decimal(10, 2)
  valorEsperado  Decimal?    @db.Decimal(10, 2)
  valorContado   Decimal?    @db.Decimal(10, 2)
  diferenca      Decimal?    @db.Decimal(10, 2)
  observacoes    String?
  aberturaEm     DateTime    @default(now())
  fechamentoEm   DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  usuario        Usuario     @relation(fields: [usuarioId], references: [id])
  movimentos     MovimentoCaixa[]
  vendas         Venda[]

  @@map("caixas")
}

// ─────────────── MOVIMENTOS DO CAIXA ───────────────

enum TipoMovimentoCaixa {
  ABERTURA
  SUPRIMENTO
  SANGRIA
  VENDA
  DEVOLUCAO
  FECHAMENTO
}

model MovimentoCaixa {
  id          String              @id @default(uuid())
  caixaId     String
  usuarioId   String
  tipo        TipoMovimentoCaixa
  valor       Decimal             @db.Decimal(10, 2)
  descricao   String?
  createdAt   DateTime            @default(now())

  caixa       Caixa               @relation(fields: [caixaId], references: [id])
  usuario     Usuario             @relation(fields: [usuarioId], references: [id])

  @@map("movimentos_caixa")
}

// ─────────────── VENDAS ───────────────

enum StatusVenda {
  ABERTA
  CONCLUIDA
  CANCELADA
}

enum FormaPagamento {
  DINHEIRO
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  POS_DEBITO
  POS_CREDITO
  VALE
  VALE_ALIMENTACAO
  VALE_REFEICAO
  FIADO
  MISTO
}

model Venda {
  id              String          @id @default(uuid())
  numero          Int             @unique @default(autoincrement())
  usuarioId       String
  clienteId       String?
  caixaId         String?
  status          StatusVenda     @default(CONCLUIDA)
  subtotal        Decimal         @db.Decimal(10, 2)
  desconto        Decimal         @db.Decimal(10, 2) @default(0)
  total           Decimal         @db.Decimal(10, 2)
  formaPagamento  FormaPagamento  @default(DINHEIRO)
  valorPago       Decimal         @db.Decimal(10, 2) @default(0)
  troco           Decimal         @db.Decimal(10, 2) @default(0)
  observacoes     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  usuario         Usuario         @relation(fields: [usuarioId], references: [id])
  cliente         Cliente?        @relation(fields: [clienteId], references: [id])
  caixa           Caixa?          @relation(fields: [caixaId], references: [id])
  itens           ItemVenda[]
  pagamentos      PagamentoVenda[]

  @@map("vendas")
}

model PagamentoVenda {
  id             String          @id @default(uuid())
  vendaId        String
  formaPagamento FormaPagamento
  valor          Decimal         @db.Decimal(10, 2)
  ordem          Int             @default(1)
  createdAt      DateTime        @default(now())

  venda          Venda           @relation(fields: [vendaId], references: [id])

  @@map("venda_pagamentos")
}

model ItemVenda {
  id          String    @id @default(uuid())
  vendaId     String
  produtoId   String
  quantidade  Float
  peso        Float?
  valorKg     Decimal?  @db.Decimal(10, 2)
  precoUnit   Decimal   @db.Decimal(10, 2)
  desconto    Decimal   @db.Decimal(10, 2) @default(0)
  subtotal    Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())

  venda       Venda     @relation(fields: [vendaId], references: [id])
  produto     Produto   @relation(fields: [produtoId], references: [id])

  @@map("itens_venda")
}

// ─────────────── COMPRAS (legado) ───────────────

enum StatusCompra {
  RASCUNHO
  CONCLUIDA
  CANCELADA
}

// ─────────────── PEDIDOS DE COMPRA ───────────────

enum StatusPedidoCompra {
  RASCUNHO
  ABERTO
  ENVIADO
  FATURADO
  EM_CONFERENCIA
  PARCIAL
  RECEBIDO
  CONCLUIDO
  CANCELADO
  DIVERGENTE
}

// ─────────────── NOTAS FISCAIS DE ENTRADA ───────────────

enum StatusNotaFiscal {
  IMPORTADA
  AGUARDANDO_VINCULO
  EM_CONFERENCIA
  COM_DIVERGENCIA
  APROVADA
  RECEBIDA
  CANCELADA
}

// ─────────────── RECEBIMENTOS ───────────────

enum StatusRecebimento {
  PENDENTE
  CONCLUIDO
  CANCELADO
}

// ─────────────── DIVERGÊNCIAS ───────────────

enum TipoDivergencia {
  QUANTIDADE_MENOR
  QUANTIDADE_MAIOR
  PRECO_DIFERENTE
  PRODUTO_NAO_SOLICITADO
  PRODUTO_NAO_IDENTIFICADO
  PRODUTO_FALTANTE
}

enum StatusDivergencia {
  PENDENTE
  RESOLVIDA
  IGNORADA
}

// ─────────────── NF-e: ENUMS FISCAIS ───────────────

enum SituacaoFiscalNfe {
  AUTORIZADA
  CANCELADA
  DENEGADA
  DESCONHECIDA
}

enum StatusIdentificacaoItem {
  IDENTIFICADO_EAN
  IDENTIFICADO_CODIGO_FORNECEDOR
  IDENTIFICADO_MANUAL
  NAO_IDENTIFICADO
}

enum TipoEventoNfe {
  // Eventos internos — criados automaticamente pelo sistema
  NFE_IMPORTADA
  FORNECEDOR_IDENTIFICADO
  FORNECEDOR_NAO_ENCONTRADO
  PRODUTO_IDENTIFICADO
  PEDIDO_VINCULADO
  CONFERENCIA_INICIADA
  DIVERGENCIA_DETECTADA
  DIVERGENCIA_AUTORIZADA
  RECEBIMENTO_CONFIRMADO
  RECEBIMENTO_ESTORNADO
  NFE_CANCELADA
  // Eventos externos — estrutura preparada para futura integração SEFAZ
  CIENCIA_OPERACAO
  CONFIRMACAO_OPERACAO
  DESCONHECIMENTO_OPERACAO
  OPERACAO_NAO_REALIZADA
  CANCELAMENTO_SEFAZ
  CARTA_CORRECAO
}

model Compra {
  id           String       @id @default(uuid())
  numero       Int          @unique @default(autoincrement())
  fornecedorId String?
  status       StatusCompra @default(RASCUNHO)
  subtotal     Decimal      @db.Decimal(10, 2)
  desconto     Decimal      @db.Decimal(10, 2) @default(0)
  total        Decimal      @db.Decimal(10, 2)
  observacoes  String?
  notaFiscal   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  fornecedor   Fornecedor?  @relation(fields: [fornecedorId], references: [id])
  itens        ItemCompra[]

  @@map("compras")
}

model ItemCompra {
  id          String    @id @default(uuid())
  compraId    String
  produtoId   String
  quantidade  Float
  precoUnit   Decimal   @db.Decimal(10, 2)
  subtotal    Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())

  compra      Compra    @relation(fields: [compraId], references: [id])
  produto     Produto   @relation(fields: [produtoId], references: [id])

  @@map("itens_compra")
}

// ─────────────── MOVIMENTOS DE ESTOQUE ───────────────

enum TipoMovimentoEstoque {
  ENTRADA_COMPRA
  ENTRADA_AJUSTE
  ENTRADA_DEVOLUCAO
  ENTRADA_NFE
  SAIDA_VENDA
  SAIDA_PERDA
  SAIDA_CONSUMO
  SAIDA_AJUSTE
  SAIDA_ESTORNO_NFE
}

model MovimentoEstoque {
  id          String               @id @default(uuid())
  produtoId   String
  tipo        TipoMovimentoEstoque
  quantidade  Float
  saldoAntes  Float
  saldoDepois Float
  referencia  String?
  motivo      String?
  createdAt   DateTime             @default(now())

  produto     Produto              @relation(fields: [produtoId], references: [id])

  @@map("movimentos_estoque")
}

// ─────────────── ETIQUETAS ───────────────

model Etiqueta {
  id         String    @id @default(uuid())
  produtoId  String
  tipo       String    @default("PRECO")
  impressora String?
  quantidade Int       @default(1)
  impressoEm DateTime  @default(now())

  produto    Produto   @relation(fields: [produtoId], references: [id])

  @@map("etiquetas")
}

// ─────────────── AUDITORIA ───────────────

model Auditoria {
  id         String   @id @default(uuid())
  usuarioId  String?
  acao       String
  tabela     String?
  registroId String?
  dadosAntes Json?
  dadosDepois Json?
  ip         String?
  createdAt  DateTime @default(now())

  usuario    Usuario?  @relation(fields: [usuarioId], references: [id])

  @@map("auditoria")
}

// ─────────────── PEDIDOS DE COMPRA ───────────────

model PedidoCompra {
  id           String             @id @default(uuid())
  numero       Int                @unique @default(autoincrement())
  fornecedorId String?
  usuarioId    String
  status       StatusPedidoCompra @default(RASCUNHO)
  total        Decimal            @db.Decimal(10, 2) @default(0)
  observacao   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  fornecedor   Fornecedor?        @relation(fields: [fornecedorId], references: [id])
  usuario      Usuario            @relation(fields: [usuarioId], references: [id])
  itens        PedidoCompraItem[]
  notasFiscais NotaFiscalEntrada[] @relation("PedidoNotasFiscais")
  nfePedidos   NfePedido[]

  @@map("pedidos_compra")
}

model PedidoCompraItem {
  id                 String       @id @default(uuid())
  pedidoId           String
  produtoId          String
  quantidade         Float
  quantidadeRecebida Float        @default(0)
  precoUnitario      Decimal      @db.Decimal(10, 2)
  subtotal           Decimal      @db.Decimal(10, 2)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  pedido             PedidoCompra @relation(fields: [pedidoId], references: [id])
  produto            Produto      @relation(fields: [produtoId], references: [id])

  @@map("pedidos_compra_itens")
}

// ─────────────── NOTAS FISCAIS DE ENTRADA ───────────────

model NotaFiscalEntrada {
  id                String           @id @default(uuid())
  fornecedorId      String?
  chaveAcesso       String           @unique
  numero            String
  serie             String
  modelo            String?
  dataEmissao       DateTime
  dataEntrada       DateTime?
  dataAutorizacao   DateTime?
  protocolo         String?
  valorTotal        Decimal          @db.Decimal(10, 2)
  status            StatusNotaFiscal @default(IMPORTADA)
  situacaoFiscal    SituacaoFiscalNfe @default(DESCONHECIDA)
  xmlPath           String?
  xmlHash           String?
  observacao        String?
  cnpjEmitente      String?
  nomeEmitente      String?
  destinatarioCnpj  String?
  destinatarioNome  String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  fornecedor    Fornecedor?      @relation(fields: [fornecedorId], references: [id])
  itens         NotaFiscalItem[]
  recebimentos  Recebimento[]
  pedidos       PedidoCompra[]   @relation("PedidoNotasFiscais")
  nfePedidos    NfePedido[]
  divergencias  Divergencia[]
  eventos       EventoNfe[]

  @@map("notas_fiscais_entrada")
}

model NotaFiscalItem {
  id                  String                  @id @default(uuid())
  notaFiscalId        String
  produtoId           String?
  codigoFornecedor    String
  gtin                String?
  descricao           String
  ncm                 String?
  cfop                String?
  unidade             String                  @default("UN")
  quantidade          Float
  valorUnitario       Decimal                 @db.Decimal(10, 2)
  desconto            Decimal                 @db.Decimal(10, 2) @default(0)
  valorTotal          Decimal                 @db.Decimal(10, 2)
  identificado        Boolean                 @default(false)
  statusIdentificacao StatusIdentificacaoItem @default(NAO_IDENTIFICADO)
  cest                String?
  csosn               String?
  cst                 String?
  valorIcms           Decimal?                @db.Decimal(10, 2)
  valorIpi            Decimal?                @db.Decimal(10, 2)
  valorPis            Decimal?                @db.Decimal(10, 2)
  valorCofins         Decimal?                @db.Decimal(10, 2)
  createdAt           DateTime                @default(now())

  notaFiscal       NotaFiscalEntrada @relation(fields: [notaFiscalId], references: [id])
  produto          Produto?          @relation(fields: [produtoId], references: [id])

  @@map("notas_fiscais_itens")
}

// ─────────────── PRODUTO × FORNECEDOR ───────────────

model ProdutoFornecedor {
  id                  String     @id @default(uuid())
  produtoId           String
  fornecedorId        String
  codigoFornecedor    String
  gtin                String?
  descricaoFornecedor String?
  ativo               Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  produto             Produto    @relation(fields: [produtoId], references: [id])
  fornecedor          Fornecedor @relation(fields: [fornecedorId], references: [id])

  @@unique([fornecedorId, codigoFornecedor])
  @@map("produto_fornecedor")
}

// ─────────────── RECEBIMENTOS ───────────────

model Recebimento {
  id              String            @id @default(uuid())
  notaFiscalId    String
  usuarioId       String
  status          StatusRecebimento @default(PENDENTE)
  dataRecebimento DateTime          @default(now())
  observacao      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  notaFiscal      NotaFiscalEntrada @relation(fields: [notaFiscalId], references: [id])
  usuario         Usuario           @relation(fields: [usuarioId], references: [id])
  itens           RecebimentoItem[]

  @@map("recebimentos")
}

model RecebimentoItem {
  id            String      @id @default(uuid())
  recebimentoId String
  produtoId     String
  quantidade    Float
  valorUnitario Decimal     @db.Decimal(10, 2)
  subtotal      Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())

  recebimento   Recebimento @relation(fields: [recebimentoId], references: [id])
  produto       Produto     @relation(fields: [produtoId], references: [id])

  @@map("recebimentos_itens")
}

// ─────────────── DIVERGÊNCIAS ───────────────

model Divergencia {
  id                 String            @id @default(uuid())
  notaFiscalId       String
  produtoId          String?
  tipo               TipoDivergencia
  status             StatusDivergencia @default(PENDENTE)
  quantidadePedida   Float?
  quantidadeNfe      Float?
  quantidadeAceita   Float?
  precoPedido        Decimal?          @db.Decimal(10, 2)
  precoNfe           Decimal?          @db.Decimal(10, 2)
  descricaoItem      String?
  resolvidoPorId     String?
  resolvidoEm        DateTime?
  observacao         String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  notaFiscal         NotaFiscalEntrada @relation(fields: [notaFiscalId], references: [id])
  produto            Produto?          @relation(fields: [produtoId], references: [id])
  resolvidoPor       Usuario?          @relation("DivergenciaResolvidaPor", fields: [resolvidoPorId], references: [id])

  @@map("divergencias")
}

// ─────────────── NF-e × PEDIDO (tabela explícita) ───────────────

model NfePedido {
  id             String            @id @default(uuid())
  nfeId          String
  pedidoId       String
  vinculadoPorId String?
  dataVinculacao DateTime          @default(now())
  observacao     String?

  nfe            NotaFiscalEntrada @relation(fields: [nfeId], references: [id])
  pedido         PedidoCompra      @relation(fields: [pedidoId], references: [id])
  vinculadoPor   Usuario?          @relation("NfePedidoVinculadoPor", fields: [vinculadoPorId], references: [id])

  @@unique([nfeId, pedidoId])
  @@map("nfe_pedidos")
}

// ─────────────── EVENTOS DA NF-e ───────────────

model EventoNfe {
  id        String        @id @default(uuid())
  nfeId     String
  tipo      TipoEventoNfe
  descricao String
  usuarioId String?
  dados     Json?
  createdAt DateTime      @default(now())

  nfe       NotaFiscalEntrada @relation(fields: [nfeId], references: [id])
  usuario   Usuario?          @relation(fields: [usuarioId], references: [id])

  @@map("eventos_nfe")
}

// ─────────────── CONFIGURAÇÕES ───────────────

model Configuracao {
  id        String   @id @default(uuid())
  chave     String   @unique
  valor     String
  descricao String?
  updatedAt DateTime @updatedAt

  @@map("configuracoes")
}
